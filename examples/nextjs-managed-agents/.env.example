# Agent provider: "claude" (default) or "cursor"
AGENT_PROVIDER=claude

# Claude Managed Agents
ANTHROPIC_API_KEY=
CLAUDE_AGENT_ID=
CLAUDE_ENVIRONMENT_ID=

# Cursor (when AGENT_PROVIDER=cursor)
