# CURSOR_REPO_URL=https://github.com/your-org/your-repo
# CURSOR_MODEL=composer-2.5

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Redis
REDIS_URL=

# Optional
# BOT_USERNAME=agent
